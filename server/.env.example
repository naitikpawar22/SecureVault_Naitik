# Server Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Database (can be stored in server/DB.env)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/securevault?retryWrites=true&w=majority
DB_NAME=securevault

# AWS S3 Storage (can be stored in server/S3.env)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-bucket-name
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
